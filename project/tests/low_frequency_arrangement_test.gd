extends "res://tests/self_arrangement_test.gd"
const LowFrequency = preload("res://low_frequency_arrangement.gd")
func due(scene) -> void:
	scene.simulation_seconds = maxf(scene.simulation_seconds,scene.low_frequency_arrangement.next_check)
	scene.needs.ensure_supply(scene.simulation_seconds)
	scene.low_frequency_arrangement.advance(scene)
func launch(scene) -> void:
	due(scene)
	scene.self_arrangement.advance(scene)
	scene.low_frequency_arrangement.advance(scene)
func clear_ledger(scene) -> void:
	var file := FileAccess.open(scene.self_arrangement.transport.base.path_join("attempts.json"),FileAccess.WRITE)
	file.store_string("[]")
	file.close()
func run() -> void:
	var off = fixture()
	off.simulation_seconds = 100000
	off.needs.ensure_supply(off.simulation_seconds)
	off.low_frequency_arrangement.advance(off)
	check(not off.low_frequency_toggle.button_pressed and off.self_arrangement.transport.starts==0 and off.self_arrangement.latest.is_empty(),"Default is off even after a long runtime")
	check(off.low_frequency_arrangement.set_enabled(off,true),"User opt-in saves")
	off._update_action_status()
	check(off.low_frequency_toggle.button_pressed and off.low_frequency_status.text.contains("60运行分钟"),"Sidebar reflects opt-in and running-time countdown")
	check(off.low_frequency_arrangement.next_check==103600,"First check is a full running hour after opt-in")
	off.low_frequency_arrangement.advance(off)
	check(off.self_arrangement.latest.is_empty(),"Enabling does not immediately request")
	launch(off)
	check(off.self_arrangement.phase()=="requesting" and off.self_arrangement.transport.starts==1,"Due idle resident makes one request")
	check(off.self_arrangement.latest.trigger=="low_frequency" and off.self_arrangement.transport.payload.context.opportunity_source=="low_frequency","Source survives in record and model observation")
	check(off.low_frequency_arrangement.attempts.size()==1 and off.low_frequency_arrangement.tracked_id==1,"One launch intent counted once")
	for i in range(10): off.low_frequency_arrangement.advance(off)
	check(off.low_frequency_arrangement.attempts.size()==1 and off.self_arrangement.transport.starts==1,"Polling does not repeat a request or count")
	check(off.self_arrangement.receive(off,answer(off)) and off.self_arrangement.recall().contains("已开启的低频安排"),"Valid none records truthful low-frequency provenance")
	off.simulation_seconds += 3599
	off.low_frequency_arrangement.advance(off)
	check(off.self_arrangement.transport.starts==1,"No new opportunity before next running hour")
	clear_ledger(off)
	launch(off)
	check(off.self_arrangement.transport.starts==2 and off.low_frequency_arrangement.attempts.size()==2,"Second due opportunity is allowed")
	off.self_arrangement.receive(off,answer(off))
	clear_ledger(off)
	due(off)
	check(off.self_arrangement.transport.starts==2 and off.low_frequency_arrangement.wait_reason=="window","Two per five running hours cap holds even if shared ledger is free")
	off.simulation_seconds = 121601
	clear_ledger(off)
	launch(off)
	check(off.self_arrangement.transport.starts==3 and off.low_frequency_arrangement.attempts.size()==2,"Old opportunity expires from rolling runtime window")
	var busy = fixture()
	busy.low_frequency_arrangement.set_enabled(busy,true)
	busy.resident.ride_requested = true
	due(busy)
	check(busy.self_arrangement.latest.is_empty() and busy.low_frequency_arrangement.wait_reason=="busy","User ride has priority without reserving model budget")
	busy.resident.ride_requested = false
	busy.needs.satiety = 20
	due(busy)
	check(busy.self_arrangement.transport.starts==0,"Hunger blocks automatic opportunity locally")
	busy.needs.satiety = 90
	busy.needs.energy = 20
	due(busy)
	check(busy.self_arrangement.transport.starts==0,"Low energy blocks automatic opportunity locally")
	busy.needs.energy = 90
	busy.chat_panel.pending = true
	due(busy)
	check(busy.self_arrangement.latest.is_empty(),"Pending manual chat takes priority")
	busy.chat_panel.pending = false
	busy.model_decision_ticket = {"kind":"test"}
	due(busy)
	check(busy.self_arrangement.latest.is_empty(),"Manual model proposal takes priority")
	busy.model_decision_ticket.clear()
	launch(busy)
	check(busy.self_arrangement.transport.starts==1,"Next local eligibility check can accept one opportunity")
	var reserve = fixture()
	reserve.low_frequency_arrangement.set_enabled(reserve,true)
	DirAccess.make_dir_recursive_absolute(reserve.self_arrangement.transport.base)
	var f := FileAccess.open(reserve.self_arrangement.transport.base.path_join("attempts.json"),FileAccess.WRITE)
	f.store_string(JSON.stringify([Time.get_unix_time_from_system()-1400,Time.get_unix_time_from_system()-1200,Time.get_unix_time_from_system()-1000,Time.get_unix_time_from_system()-500]))
	f.close()
	due(reserve)
	reserve.self_arrangement.advance(reserve)
	check(reserve.self_arrangement.transport.starts==1,"Automatic thought can use the last available attempt")
	var race = fixture()
	race.low_frequency_arrangement.set_enabled(race,true)
	due(race)
	DirAccess.make_dir_recursive_absolute(race.self_arrangement.transport.base)
	f = FileAccess.open(race.self_arrangement.transport.base.path_join("attempts.json"),FileAccess.WRITE)
	f.store_string(JSON.stringify([Time.get_unix_time_from_system()-1400,Time.get_unix_time_from_system()-1200,Time.get_unix_time_from_system()-1000,Time.get_unix_time_from_system()-500]))
	f.close()
	check(race.self_arrangement.transport.reserve(Time.get_unix_time_from_system()-200)=="ok","Another caller takes the last attempt")
	race.self_arrangement.advance(race)
	race.low_frequency_arrangement.advance(race)
	check(race.self_arrangement.transport.starts==0 and not race.low_frequency_arrangement.enabled,"Budget is rechecked immediately before launch; race pauses without request")
	var failed = fixture()
	failed.low_frequency_arrangement.set_enabled(failed,true)
	launch(failed)
	failed.self_arrangement.receive(failed,{"status":"timeout"})
	failed.low_frequency_arrangement.advance(failed)
	check(not failed.low_frequency_arrangement.enabled and failed.low_frequency_arrangement.last_error=="timeout","Failed automatic thought pauses switch")
	failed.simulation_seconds += 20000
	failed.needs.ensure_supply(failed.simulation_seconds)
	failed.low_frequency_arrangement.advance(failed)
	check(failed.self_arrangement.transport.starts==1,"Failure never auto-retries")
	clear_ledger(failed)
	check(failed.low_frequency_arrangement.set_enabled(failed,true),"Explicit user re-enable is allowed")
	failed.low_frequency_arrangement.advance(failed)
	check(failed.low_frequency_arrangement.enabled,"Acknowledged old failure does not immediately pause re-enable")
	launch(failed)
	check(failed.self_arrangement.transport.starts==2,"Re-enable waits a new full hour then permits a new choice")
	var disable = fixture()
	disable.low_frequency_arrangement.set_enabled(disable,true)
	due(disable)
	check(disable.low_frequency_arrangement.set_enabled(disable,false) and disable.self_arrangement.phase()=="cancelled" and disable.self_arrangement.transport.starts==0,"Turning off cancels pending automatic opportunity without launch")
	disable._update_action_status()
	check(not disable.low_frequency_toggle.button_pressed,"Sidebar reflects disabled persisted switch")
	var thinking = fixture()
	thinking.low_frequency_arrangement.set_enabled(thinking,true)
	launch(thinking)
	var late_reply: Dictionary = answer(thinking,"visit_plant")
	thinking.low_frequency_arrangement.set_enabled(thinking,false)
	check(not thinking.self_arrangement.receive(thinking,late_reply) and thinking.plant_visit.latest.is_empty(),"Turning off rejects late automatic reply without action")
	var execution = fixture()
	execution.low_frequency_arrangement.set_enabled(execution,true)
	launch(execution)
	execution.self_arrangement.receive(execution,answer(execution,"visit_plant"))
	execution.low_frequency_arrangement.set_enabled(execution,false)
	check(execution.self_arrangement.phase()=="executing" and execution.plant_visit.active(),"Disabling does not erase accepted real action")
	var manual = fixture()
	manual.low_frequency_arrangement.set_enabled(manual,true)
	begin(manual)
	manual.self_arrangement.receive(manual,{"status":"timeout"})
	manual.low_frequency_arrangement.advance(manual)
	check(manual.low_frequency_arrangement.enabled and manual.low_frequency_arrangement.attempts.is_empty(),"Manual opportunity failure does not pause or count as automatic")
	var settings_fail = fixture()
	settings_fail.store = FailedStore.new()
	check(not settings_fail.low_frequency_arrangement.set_enabled(settings_fail,true) and not settings_fail.low_frequency_arrangement.enabled,"Failed settings save rolls back opt-in")
	var arm_fail = fixture()
	arm_fail.low_frequency_arrangement.set_enabled(arm_fail,true)
	arm_fail.store = FailedStore.new()
	due(arm_fail)
	check(not arm_fail.low_frequency_arrangement.enabled and arm_fail.self_arrangement.latest.is_empty() and arm_fail.self_arrangement.transport.starts==0,"Failed atomic reservation never launches and pauses")
	var crash = fixture()
	crash.low_frequency_arrangement.set_enabled(crash,true)
	due(crash)
	var atomic: Dictionary = crash.store.load_state().state
	check(atomic.world_state.low_frequency_arrangement.tracked_id==atomic.world_state.self_arrangement.latest.id and atomic.world_state.low_frequency_arrangement.next_check==7200,"Opportunity and next check persist atomically")
	crash.self_arrangement.advance(crash)
	var requesting: Dictionary = crash.store.load_state().state
	check(requesting.world_state.low_frequency_arrangement.attempts.is_empty() and requesting.world_state.self_arrangement.latest.observed_seconds==3600,"Crash fixture stops after launch intent but before counter update")
	var resumed = fixture()
	resumed.simulation_seconds = requesting.simulation_seconds
	resumed.self_arrangement.restore(requesting.world_state.self_arrangement,resumed.simulation_seconds)
	resumed.low_frequency_arrangement.restore(requesting.world_state.low_frequency_arrangement)
	resumed.low_frequency_arrangement.advance(resumed)
	check(not resumed.low_frequency_arrangement.enabled and resumed.low_frequency_arrangement.attempts.size()==1 and resumed.self_arrangement.transport.starts==0,"Restart recovers counter, cancels interrupted thought and pauses without replay")
	var idle_restart = fixture()
	idle_restart.simulation_seconds = 300
	idle_restart.low_frequency_arrangement.set_enabled(idle_restart,true)
	var restored := LowFrequency.new()
	restored.restore(idle_restart.low_frequency_arrangement.snapshot())
	check(restored.next_check-idle_restart.simulation_seconds==3600 and restored.enabled,"Sleeping or restarting does not advance runtime schedule")
	var value: Dictionary = off.low_frequency_arrangement.snapshot()
	check(LowFrequency.valid_snapshot(value,off.simulation_seconds,off.self_arrangement.snapshot()),"Rolling scheduler snapshot validates")
	var corrupt := value.duplicate(true)
	corrupt.next_check = off.simulation_seconds+3601
	check(not LowFrequency.valid_snapshot(corrupt,off.simulation_seconds,off.self_arrangement.snapshot()),"Reject future schedule beyond interval")
	corrupt = value.duplicate(true)
	corrupt.attempts.append(corrupt.attempts.back())
	check(not LowFrequency.valid_snapshot(corrupt,off.simulation_seconds,off.self_arrangement.snapshot()),"Reject duplicate or oversized counters")
	corrupt = value.duplicate(true)
	corrupt.tracked_id = off.self_arrangement.next_id
	check(not LowFrequency.valid_snapshot(corrupt,off.simulation_seconds,off.self_arrangement.snapshot()),"Reject reservation referencing nonexistent opportunity")
	corrupt = value.duplicate(true)
	corrupt.attempts[0].seconds = off.simulation_seconds+1
	check(not LowFrequency.valid_snapshot(corrupt,off.simulation_seconds,off.self_arrangement.snapshot()),"Reject future counter timestamps")
	check(off._save_now() and off.store.load_state().state.world_state.low_frequency_arrangement.enabled,"Whole-world save includes validated opt-in and counters")
	var legacy = fixture()
	begin(legacy)
	legacy.self_arrangement.receive(legacy,answer(legacy))
	legacy._save_now()
	var old_state: Dictionary = legacy.store.load_state().state
	old_state.world_state.erase("low_frequency_arrangement")
	old_state.world_state.self_arrangement.latest.erase("trigger")
	old_state.world_state.self_arrangement.latest.observation.erase("opportunity_source")
	check(Store.valid_state(old_state),"Old one-off records without scheduler or source remain readable")
	legacy.self_arrangement.restore(old_state.world_state.self_arrangement,legacy.simulation_seconds)
	check(legacy.self_arrangement.recall().contains("用户给出的一次机会") and not legacy.low_frequency_arrangement.enabled,"Migration keeps old provenance and never enables automation")
	print("LOW_FREQUENCY_ARRANGEMENT_TEST_RESULT checks=",checks," failures=",failures)
	quit(0 if failures==0 else 1)
