config_version=5

[application]
config/name="Elm World Public Preview"
config/use_custom_user_dir=true
config/custom_user_dir_name="ElmWorldPublicPreview"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.0", "GL Compatibility")
run/low_processor_mode=true

[display]
window/energy_saving/keep_screen_on=false
window/size/viewport_width=1200
window/size/viewport_height=800
window/size/window_width_override=1200
window/size/window_height_override=800

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.94, 0.92, 0.85, 1)

textures/default_filters/use_nearest_mipmap_filter=false
